{{ 'section-distribuidora.css' | asset_url | stylesheet_tag }}

<section
  class="dist dist-brands"
  style="--brands-label-size: {{ section.settings.label_size }}px; --brands-item-size: {{ section.settings.item_size }}px; --brands-logo-height: {{ section.settings.logo_height }}px;"
>
  {%- if section.settings.label != blank -%}
    <p class="dist-brands__label">{{ section.settings.label }}</p>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="dist-brands__viewport">
      <div class="dist-brands__track" style="--speed: {{ section.settings.speed }}s">
        {%- for i in (1..2) -%}
          {%- for block in section.blocks -%}
            {%- liquid
              assign brand_url = block.settings.link
              if block.settings.collection != blank
                assign brand_url = block.settings.collection.url
              endif
            -%}
            {%- if brand_url != blank -%}
              <a
                href="{{ brand_url }}"
                class="dist-brands__item dist-brands__item--link"
                {% if i == 1 %}{{ block.shopify_attributes }}{% else %}aria-hidden="true" tabindex="-1"{% endif %}
              >
            {%- else -%}
              <div class="dist-brands__item" {% if i == 1 %}{{ block.shopify_attributes }}{% else %}aria-hidden="true"{% endif %}>
            {%- endif -%}
              {%- if block.settings.logo != blank -%}
                {{ block.settings.logo | image_url: height: 120 | image_tag: loading: 'lazy', alt: block.settings.name }}
              {%- else -%}
                {{ block.settings.name }}
              {%- endif -%}
            {%- if brand_url != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Distribuidora: Marcas",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "label", "label": "Texto superior", "default": "Editoriales que distribuimos" },
    { "type": "range", "id": "label_size", "label": "Tamaño del texto superior", "min": 10, "max": 40, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "item_size", "label": "Tamaño de las editoriales", "min": 16, "max": 72, "step": 2, "unit": "px", "default": 26 },
    { "type": "range", "id": "logo_height", "label": "Altura de los logos", "min": 24, "max": 120, "step": 4, "unit": "px", "default": 44 },
    { "type": "range", "id": "speed", "label": "Velocidad (segundos por vuelta)", "min": 15, "max": 90, "step": 5, "unit": "s", "default": 40 }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Editorial",
      "settings": [
        { "type": "text", "id": "name", "label": "Nombre", "default": "Editorial" },
        { "type": "image_picker", "id": "logo", "label": "Logo (opcional)", "info": "Si no hay logo se muestra el nombre" },
        { "type": "collection", "id": "collection", "label": "Colección de la editorial", "info": "Al hacer clic en la editorial, lleva a esta colección" },
        { "type": "url", "id": "link", "label": "Link alternativo (opcional)", "info": "Se usa solo si no eliges colección" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Distribuidora: Marcas",
      "blocks": [
        { "type": "brand", "settings": { "name": "Planeta" } },
        { "type": "brand", "settings": { "name": "Penguin Random House" } },
        { "type": "brand", "settings": { "name": "Tusquets" } },
        { "type": "brand", "settings": { "name": "Seix Barral" } },
        { "type": "brand", "settings": { "name": "Grámmata" } },
        { "type": "brand", "settings": { "name": "Destino" } },
        { "type": "brand", "settings": { "name": "Paidós" } }
      ]
    }
  ]
}
{% endschema %}
