{{ 'section-distribuidora.css' | asset_url | stylesheet_tag }}
{%- if section.settings.filter_mode -%}
  {{ 'component-card.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'distribuidora-brand-filter.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<section
  class="dist dist-brands{% unless section.settings.logos_grayscale %} dist-brands--color{% endunless %}"
  style="--brands-label-size: {{ section.settings.label_size }}px; --brands-item-size: {{ section.settings.item_size }}px; --brands-logo-height: {{ section.settings.logo_height }}px; --brands-bg: {{ section.settings.background_color }};"
  {% if section.settings.filter_mode %}data-brand-filter{% endif %}
>
  {%- if section.settings.label != blank -%}
    <p class="dist-brands__label">{{ section.settings.label }}</p>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="dist-brands__viewport">
      <div class="dist-brands__track" style="--speed: {{ section.settings.speed }}s">
        {%- for i in (1..2) -%}
          {%- for block in section.blocks -%}
            {%- liquid
              assign brand_url = block.settings.link
              if block.settings.collection != blank
                assign brand_url = block.settings.collection.url
              endif
            -%}
            {%- if brand_url != blank -%}
              <a
                href="{{ brand_url }}"
                class="dist-brands__item dist-brands__item--link"
                {% if block.settings.collection != blank %}
                  data-brand-key="{{ block.id }}"
                  data-brand-name="{{ block.settings.name | escape }}"
                {% endif %}
                {% if i == 1 %}{{ block.shopify_attributes }}{% else %}aria-hidden="true" tabindex="-1"{% endif %}
              >
            {%- else -%}
              <div class="dist-brands__item" {% if i == 1 %}{{ block.shopify_attributes }}{% else %}aria-hidden="true"{% endif %}>
            {%- endif -%}
              {%- if block.settings.logo != blank -%}
                {{ block.settings.logo | image_url: height: 400 | image_tag: loading: 'lazy', alt: block.settings.name }}
              {%- else -%}
                {{ block.settings.name }}
              {%- endif -%}
            {%- if brand_url != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.filter_mode and section.settings.hint != blank -%}
      <p class="dist-brands__hint">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 11V5.5a1.5 1.5 0 0 1 3 0V10"/><path d="M12 9.5a1.5 1.5 0 0 1 3 0V11"/><path d="M15 10.5a1.5 1.5 0 0 1 3 0V15a6 6 0 0 1-6 6h-1a6 6 0 0 1-4.8-2.4L3.6 15a1.5 1.5 0 0 1 2.3-1.9L9 16"/></svg>
        <span>{{ section.settings.hint }}</span>
      </p>
    {%- endif -%}

    {%- if section.settings.filter_mode -%}
      <div class="dist-results" data-brand-results hidden>
        <div class="dist__container">
          <div class="dist-results__bar">
            <p class="dist-results__hint">
              Mostrando títulos de <strong data-brand-results-name></strong>
            </p>
            <button type="button" class="dist-results__clear" data-brand-clear>
              Ver todas las editoriales
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
          <div class="dist-results__body" data-brand-results-body aria-live="polite"></div>
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Distribuidora: Marcas",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "label", "label": "Texto superior", "default": "Editoriales que distribuimos" },
    { "type": "checkbox", "id": "filter_mode", "label": "Usar logos como filtro", "info": "Al hacer clic en una editorial con colección, sus libros se muestran debajo sin salir de la página.", "default": true },
    { "type": "text", "id": "hint", "label": "Mensaje de ayuda bajo los logos", "default": "Toca una editorial para ver sus libros · pasa el cursor para detener la barra" },
    { "type": "range", "id": "label_size", "label": "Tamaño del texto superior", "min": 10, "max": 40, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "item_size", "label": "Tamaño de las editoriales", "min": 16, "max": 72, "step": 2, "unit": "px", "default": 26 },
    { "type": "range", "id": "logo_height", "label": "Altura de los logos", "min": 24, "max": 200, "step": 4, "unit": "px", "default": 96 },
    { "type": "checkbox", "id": "logos_grayscale", "label": "Logos en escala de grises (a color al pasar el mouse)", "default": false },
    { "type": "color", "id": "background_color", "label": "Color de fondo", "default": "#ffffff" },
    { "type": "range", "id": "speed", "label": "Velocidad (segundos por vuelta)", "min": 15, "max": 90, "step": 5, "unit": "s", "default": 40 }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Editorial",
      "settings": [
        { "type": "text", "id": "name", "label": "Nombre", "default": "Editorial" },
        { "type": "image_picker", "id": "logo", "label": "Logo (opcional)", "info": "Si no hay logo se muestra el nombre" },
        { "type": "collection", "id": "collection", "label": "Colección de la editorial", "info": "Al hacer clic en la editorial, lleva a esta colección" },
        { "type": "url", "id": "link", "label": "Link alternativo (opcional)", "info": "Se usa solo si no eliges colección" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Distribuidora: Marcas",
      "blocks": [
        { "type": "brand", "settings": { "name": "Planeta" } },
        { "type": "brand", "settings": { "name": "Penguin Random House" } },
        { "type": "brand", "settings": { "name": "Tusquets" } },
        { "type": "brand", "settings": { "name": "Seix Barral" } },
        { "type": "brand", "settings": { "name": "Grámmata" } },
        { "type": "brand", "settings": { "name": "Destino" } },
        { "type": "brand", "settings": { "name": "Paidós" } }
      ]
    }
  ]
}
{% endschema %}
