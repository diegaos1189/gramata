{{ 'section-trust-badges.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{%- liquid
  assign icon_truck = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="6" width="14" height="11"/><path d="M15 10h4l3 3v4h-7z"/><circle cx="6" cy="19" r="2"/><circle cx="17.5" cy="19" r="2"/></svg>'
  assign icon_shield = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 3.5v6c0 5-3.4 8.7-8 10.5-4.6-1.8-8-5.5-8-10.5v-6z"/><path d="M9 12l2 2 4-4.5"/></svg>'
  assign icon_refresh = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 15.3-6.4L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15.3 6.4L3 16"/><path d="M3 21v-5h5"/></svg>'
  assign icon_gift = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="13"/><path d="M3 8h18v4H3z"/><path d="M12 8v13"/><path d="M12 8C10 4 6 4 6 6.5S9 8 12 8z"/><path d="M12 8c2-4 6-4 6-1.5S15 8 12 8z"/></svg>'
  assign icon_heart = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20.3 3.9 12.6a5 5 0 1 1 7.3-6.8L12 7l.8-1.2a5 5 0 1 1 7.3 6.8z"/></svg>'
  assign icon_book = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v17H6.5A2.5 2.5 0 0 0 4 21.5z"/><path d="M20 19H6.5a2.5 2.5 0 0 0 0 5H20"/></svg>'
-%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding page-width">
  <ul class="trust-badges" role="list">
    {%- for block in section.blocks -%}
      {%- liquid
        case block.settings.icon_name
          when 'shield'
            assign icon_svg = icon_shield
          when 'refresh'
            assign icon_svg = icon_refresh
          when 'gift'
            assign icon_svg = icon_gift
          when 'heart'
            assign icon_svg = icon_heart
          when 'book'
            assign icon_svg = icon_book
          else
            assign icon_svg = icon_truck
        endcase
      -%}
      <li class="trust-badges__item" {{ block.shopify_attributes }}>
        <div class="trust-badges__icon">
          {%- if block.settings.icon != blank -%}
            {{ block.settings.icon | image_url: width: 80 | image_tag: loading: 'lazy', alt: '' }}
          {%- else -%}
            {{ icon_svg }}
          {%- endif -%}
        </div>
        <div class="trust-badges__text">
          {%- if block.settings.heading != blank -%}
            <p class="trust-badges__heading">{{ block.settings.heading }}</p>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="trust-badges__subtext">{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Confianza (trust badges)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado superior",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado inferior",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Insignia",
      "settings": [
        {
          "type": "select",
          "id": "icon_name",
          "label": "Icono",
          "options": [
            { "value": "truck", "label": "Camión / envío" },
            { "value": "shield", "label": "Escudo / seguridad" },
            { "value": "refresh", "label": "Cambios / devolución" },
            { "value": "gift", "label": "Regalo" },
            { "value": "heart", "label": "Corazón" },
            { "value": "book", "label": "Libro" }
          ],
          "default": "truck"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icono personalizado (opcional)",
          "info": "Si subes una imagen, reemplaza al icono de arriba."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Envío a todo el país"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Recíbelo en la puerta de tu casa"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Confianza (trust badges)",
      "blocks": [
        {
          "type": "badge",
          "settings": { "icon_name": "truck", "heading": "Envío a todo Colombia", "text": "Recíbelo donde estés" }
        },
        {
          "type": "badge",
          "settings": { "icon_name": "shield", "heading": "Pago 100% seguro", "text": "Tarjetas, PSE y contraentrega" }
        },
        {
          "type": "badge",
          "settings": { "icon_name": "refresh", "heading": "Cambios y devoluciones", "text": "Hasta 30 días" }
        }
      ]
    }
  ]
}
{% endschema %}
