{{ 'section-trust-badges.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding page-width">
  <ul class="trust-badges" role="list">
    {%- for block in section.blocks -%}
      <li class="trust-badges__item" {{ block.shopify_attributes }}>
        {%- if block.settings.icon != blank -%}
          <div class="trust-badges__icon">
            {{ block.settings.icon | image_url: width: 80 | image_tag: loading: 'lazy', alt: '' }}
          </div>
        {%- endif -%}
        <div class="trust-badges__text">
          {%- if block.settings.heading != blank -%}
            <p class="trust-badges__heading">{{ block.settings.heading }}</p>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="trust-badges__subtext">{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Confianza (trust badges)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado superior",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaciado inferior",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Insignia",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icono"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Envío a todo el país"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Recíbelo en la puerta de tu casa"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Confianza (trust badges)",
      "blocks": [
        {
          "type": "badge",
          "settings": { "heading": "Envío a todo Colombia", "text": "Recíbelo donde estés" }
        },
        {
          "type": "badge",
          "settings": { "heading": "Pago 100% seguro", "text": "Tarjetas, PSE y contraentrega" }
        },
        {
          "type": "badge",
          "settings": { "heading": "Cambios y devoluciones", "text": "Hasta 30 días" }
        }
      ]
    }
  ]
}
{% endschema %}
