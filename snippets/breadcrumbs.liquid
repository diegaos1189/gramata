{% comment %}
  Renders breadcrumb navigation with BreadcrumbList structured data.
  Accepts:
  - product: {Object} Product Liquid object (optional)
  - collection: {Object} Collection Liquid object (optional)
{% endcomment %}
{%- liquid
  assign home_label = 'general.breadcrumbs.home' | t
  assign crumb_titles_str = home_label
  assign crumb_urls_str = routes.root_url

  if product
    assign product_collection = product.collections.first
    if product_collection
      assign crumb_titles_str = crumb_titles_str | append: '::' | append: product_collection.title
      assign crumb_urls_str = crumb_urls_str | append: '::' | append: product_collection.url
    endif
    assign crumb_titles_str = crumb_titles_str | append: '::' | append: product.title
    assign crumb_urls_str = crumb_urls_str | append: '::' | append: product.url
  elsif collection
    assign crumb_titles_str = crumb_titles_str | append: '::' | append: collection.title
    assign crumb_urls_str = crumb_urls_str | append: '::' | append: collection.url
  endif

  assign crumb_titles = crumb_titles_str | split: '::'
  assign crumb_urls = crumb_urls_str | split: '::'
-%}

<nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs.label' | t }}">
  <ol class="breadcrumbs__list">
    {%- for title in crumb_titles -%}
      {%- assign forloop_index0 = forloop.index0 -%}
      <li class="breadcrumbs__item">
        {%- if forloop.last -%}
          <span aria-current="page">{{ title }}</span>
        {%- else -%}
          <a href="{{ crumb_urls[forloop_index0] }}">{{ title }}</a>
          <span class="breadcrumbs__separator" aria-hidden="true">/</span>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ol>
</nav>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {%- for title in crumb_titles -%}
        {%- assign forloop_index0 = forloop.index0 -%}
        {
          "@type": "ListItem",
          "position": {{ forloop.index }},
          "name": {{ title | json }},
          "item": {{ crumb_urls[forloop_index0] | prepend: request.origin | json }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
</script>
